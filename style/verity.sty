% --- Severity swatch ----------------------------------------------------------
% A small filled square keyed by palette colour. Used in the findings-overview
% table to give the eye a colour anchor before reading the severity label, and
% to match the left-rule colour on the finding boxes themselves.
\newcommand{\sevswatch}[1]{%
  \tikz[baseline=-0.6ex]\fill[#1] (0,0) rectangle (1.4ex,1.4ex);%
}

% --- Severity bar -------------------------------------------------------------
% A short horizontal bar that visualises the count of findings at a severity
% level. Arg 1 = palette colour, arg 2 = count, arg 3 = the maximum count
% any row in the same table reaches (the bars share a scale so widths are
% comparable). When count == 0 we still draw the underline rail so the
% baseline is visible.
\newcommand{\sevbar}[3]{%
  \begin{tikzpicture}[baseline=-0.6ex]
    \fill[vrule] (0,0) rectangle (1.8cm,0.18cm);%
    \ifnum#2>0
      \fill[#1] (0,0) rectangle (\fpeval{1.8*#2/#3}cm,0.18cm);%
    \fi
  \end{tikzpicture}%
}

% --- Severity marks (typographic, no box) -------------------------------------
% Severity is rendered as small-caps in a muted severity ink - no box, no
% fill. Critical and High carry bold weight; Medium and Low regular weight;
% Informational is italic. Signal is carried by color + weight alone, so the
% marks remain legible in monochrome print (weight/style survive; color
% washes out harmlessly).
\newcommand{\sevmark}[2]   {{\color{#1}\scshape #2}}
\newcommand{\sevmarkbf}[2] {{\color{#1}\bfseries\scshape #2}}
\newcommand{\sevmarkit}[2] {{\color{#1}\itshape\scshape #2}}

\newcommand{\sevCritical}{\sevmarkbf{sevcrit}{Critical}}
\newcommand{\sevHigh}    {\sevmarkbf{sevhigh}{High}}
\newcommand{\sevMedium}  {\sevmark  {sevmed}{Medium}}
\newcommand{\sevLow}     {\sevmark  {sevlow}{Low}}
\newcommand{\sevInfo}    {\sevmarkit{sevinfo}{Informational}}

% --- Severity cells -----------------------------------------------------------
% \sevcell{key} renders a soft table cell: tinted background, compact square
% colour anchor, and severity-coloured text. This keeps release/blocker tables
% scannable without introducing aggressive red/orange bands.
%
% Usage: place inside a tabular cell:
%   \sevcell{crit} & MED-01 & ... \\
%
% Implementation note: \cellcolor is invoked inside the macro so callers
% don't have to know about colortbl. Pair with a column spec that supplies
% the leading/trailing pad you want around the band.
\newcommand{\sevcell}[1]{%
  \def\sev@@key{#1}%
  \ifx\sev@@key\sev@@kCritical
    \cellcolor{sevcrittint}{\textcolor{sevcrit}{\rule{0.42em}{0.42em}}\hspace{0.25em}{\sffamily\bfseries\scriptsize\color{sevcrit}Critical}}\else
  \ifx\sev@@key\sev@@kHigh
    \cellcolor{sevhightint}{\textcolor{sevhigh}{\rule{0.42em}{0.42em}}\hspace{0.25em}{\sffamily\bfseries\scriptsize\color{sevhigh}High}}\else
  \ifx\sev@@key\sev@@kMedium
    \cellcolor{sevmedtint}{\textcolor{sevmed}{\rule{0.42em}{0.42em}}\hspace{0.25em}{\sffamily\bfseries\scriptsize\color{sevmed}Medium}}\else
  \ifx\sev@@key\sev@@kLow
    \cellcolor{sevlowtint}{\textcolor{sevlow}{\rule{0.42em}{0.42em}}\hspace{0.25em}{\sffamily\bfseries\scriptsize\color{sevlow}Low}}\else
  \ifx\sev@@key\sev@@kInfo
    \cellcolor{sevinfotint}{\textcolor{sevinfo}{\rule{0.42em}{0.42em}}\hspace{0.25em}{\sffamily\bfseries\scriptsize\color{sevinfo}Info}}\else
    \cellcolor{sevinfotint}{\textcolor{sevinfo}{\rule{0.42em}{0.42em}}\hspace{0.25em}{\sffamily\bfseries\scriptsize\color{sevinfo}#1}}%
  \fi\fi\fi\fi\fi
}
\def\sev@@kCritical{crit}
\def\sev@@kHigh{high}
\def\sev@@kMedium{med}
\def\sev@@kLow{low}
\def\sev@@kInfo{info}

% \sevrowcolor{key} - set the whole table row to the muted tint of the
% severity. Place at the start of the row, before any cells. Tints carry
% the same colour family as \sevcell but at low saturation so the row's
% text remains readable in body ink.
\newcommand{\sevrowcolor}[1]{%
  \def\sev@@key{#1}%
  \ifx\sev@@key\sev@@kCritical \rowcolor{sevcrittint}\else
  \ifx\sev@@key\sev@@kHigh     \rowcolor{sevhightint}\else
  \ifx\sev@@key\sev@@kMedium   \rowcolor{sevmedtint}\else
  \ifx\sev@@key\sev@@kLow      \rowcolor{sevlowtint}\else
  \ifx\sev@@key\sev@@kInfo     \rowcolor{sevinfotint}%
  \fi\fi\fi\fi\fi
}

% --- Status marks (typographic, no box) ---------------------------------------
% Mirrors the severity treatment: status is small-caps in a muted state ink.
% Regular weight distinguishes a state from a (bold) severity of the same hue.
\newcommand{\stsmark}[2]{{\color{#1}\scshape #2}}
\newcommand{\stsOpen}        {\stsmark{sevcrit}{Open}}
\newcommand{\stsAcknowledged}{\stsmark{sevmed}{Acknowledged}}
\newcommand{\stsResolved}    {\stsmark{sevok}{Resolved}}
\newcommand{\stsExpected}    {\stsmark{sevinfo}{Expected}}

% --- Table helpers ------------------------------------------------------------
% Wrap header rows with \theadrow{...} to apply muted sans formatting WITHOUT
% leaking \sffamily into the surrounding paragraph (a known tabularx quirk).
\newcommand{\thead}[1]{{\sffamily\color{vmuted}\footnotesize #1}}
% Wrap a metadata cell value with \tkey{...} for the left "label" column.
\newcommand{\tkey}[1]{{\sffamily\color{vmuted}\footnotesize #1}}

% --- Info / quote panels ------------------------------------------------------
\newtcolorbox{notebox}{
  enhanced, breakable,
  colback=vsurface, colframe=vrule,
  borderline west={2.2pt}{0pt}{vaccent},
  boxrule=0.35pt, arc=0pt,
  left=10pt, right=10pt, top=8pt, bottom=8pt,
  fontupper=\small
}

% Block heading for callout boxes: own line, sans accent, set off from body text.
\newcommand{\noteboxtitle}[1]{%
  {\sffamily\bfseries\color{vaccent}#1}\par\smallskip}

\endinput
