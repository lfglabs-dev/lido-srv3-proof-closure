% --- Inline code --------------------------------------------------------------
% Source references and identifiers appear frequently in audit findings. Render
% inline monospace as a quiet pill so anchors like file.sql:11-24 remain visibly
% distinct from the prose without adding heavy visual noise.
\let\verityorigtexttt\texttt
\newtcbox{\veritycodepill}{%
  enhanced,
  on line,
  nobeforeafter,
  tcbox raise base,
  colback=vcodebg,
  colframe=vcodebd,
  boxrule=0.30pt,
  arc=0pt,
  left=2.2pt,
  right=2.2pt,
  top=1.1pt,
  bottom=0.7pt,
  boxsep=0pt,
}
\renewcommand{\texttt}[1]{\veritycodepill{\verityorigtexttt{\footnotesize #1}}}

% \texttts -- "simple texttt", no pill background. Use inside dense
% tables (issue index, findings overview) where the pill multiplies and
% adds visual noise, or inside lstlistings where the pill would conflict
% with the code background.
\newcommand{\texttts}[1]{{\verityorigtexttt{\footnotesize #1}}}

% NOTE: We considered redirecting \path through the chip macro for visual
% uniformity, but \path uses verbatim-mode tokenisation so wrapping it in
% a tcolorbox breaks on file names containing _, %, etc. \path stays as
% plain \ttfamily; the subtle distinction between chip (\texttt) and bare
% mono (\path) is acceptable.
%
% Let \path{}/\url{} break long camelCase, ALLCAPS, and hex identifiers. url's
% default \UrlBreaks already covers snake_case (it lists \_); we add both letter
% cases, digits, and hyphen so names like transferAndWithdrawalVerifyBeforeSpendConcrete,
% AG-WITHDRAW-SLOT, and lowercase commit hashes like ba2cbbf09d49...c4138c05 wrap
% inside their column or line instead of bleeding into the right margin. url only
% takes a break point when a token would otherwise overflow, so adding these can
% only reduce overflow, never reflow lines that already fit.
\def\UrlBreaks{\do\.\do\@\do\\\do\/\do\!\do\_\do\|\do\;\do\>\do\]\do\)\do\,\do\?\do\&\do\'\do+\do\=\do\#\do\-%
  \do\A\do\B\do\C\do\D\do\E\do\F\do\G\do\H\do\I\do\J\do\K\do\L\do\M%
  \do\N\do\O\do\P\do\Q\do\R\do\S\do\T\do\U\do\V\do\W\do\X\do\Y\do\Z%
  \do\a\do\b\do\c\do\d\do\e\do\f\do\g\do\h\do\i\do\j\do\k\do\l\do\m%
  \do\n\do\o\do\p\do\q\do\r\do\s\do\t\do\u\do\v\do\w\do\x\do\y\do\z%
  \do\0\do\1\do\2\do\3\do\4\do\5\do\6\do\7\do\8\do\9}%

