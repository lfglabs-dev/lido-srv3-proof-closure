% verity.sty - LFG Labs report style using Verity formal artifacts
% Minimalist, research-paper aesthetic. pdflatex-friendly.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{style/verity}[2026/04/23 Verity report style]

% --- Encoding & fonts ---------------------------------------------------------
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
% Body face: XCharter (modern serif, high x-height, audit-firm register).
% Sans face: Latin Modern Sans (kept for headings / labels - pairs cleanly).
% Mono face: Inconsolata (legible monospace for code listings).
\RequirePackage{lmodern}        % provides matching \sffamily / fallback metrics
\RequirePackage[scaled=1.04]{XCharter}
\renewcommand{\sfdefault}{lmss}
\RequirePackage[varqu,varl,scaled=0.97]{inconsolata}
\RequirePackage[charter]{mathdesign}
\RequirePackage{microtype}      % crisp typography
\RequirePackage{textcomp}

% --- Page geometry ------------------------------------------------------------
\RequirePackage[a4paper,
                top=1in, bottom=1.1in,
                left=1.15in, right=1.15in,
                headheight=22pt, headsep=18pt,
                footskip=28pt]{geometry}

