% --- Headings ----------------------------------------------------------------
\RequirePackage{titlesec}
\RequirePackage{titletoc}
% --- TOC styling: airier leaders ----------------------------------------------
% Replace LaTeX's dense default dotted leaders with sparse muted dots, and
% give section / subsection entries a bit more vertical breathing room. The
% pageref colour matches the body ink so the right-aligned numbers feel like
% a single typographic column.
\titlecontents{section}[0pt]
  {\addvspace{4pt}\bfseries\color{vheading}}
  {\contentslabel{1.6em}}{\hspace*{-1.6em}}
  {\titlerule*[8pt]{\textcolor{vrule}{.}}\contentspage}
\titlecontents{subsection}[2.4em]
  {\addvspace{1pt}\sffamily\color{vmuted}}
  {\contentslabel{2.4em}}{\hspace*{-2.4em}}
  {\titlerule*[8pt]{\textcolor{vrule}{.}}\contentspage}
% --- TOC group dividers -------------------------------------------------------
% Category separators inside the table of contents so a reader can take in the
% report's structure at a glance. \tocgroup writes a styled label and hairline
% at the current body position; place a call before each group's first \input.
\newcommand{\tocdivider}[1]{%
  \addvspace{11pt}%
  {\noindent\sffamily\bfseries\footnotesize\color{vaccent}\MakeUppercase{#1}}\par
  \vskip 2.5pt%
  {\noindent\color{vrule}\rule{\linewidth}{0.4pt}}\par
  \vskip 4pt%
}
\newcommand{\tocgroup}[1]{\addtocontents{toc}{\protect\tocdivider{#1}}}
\titleformat{\section}
  {\normalfont\Large\bfseries\color{vheading}}
  {\sffamily\bfseries\color{vaccent}\thesection}{1em}{}
  [\vspace{0.25ex}{\color{vrule}\titlerule[0.35pt]}]
\titleformat{\subsection}
  {\normalfont\large\bfseries\color{vheading}}
  {\thesubsection}{0.8em}{}
\titleformat{\subsubsection}
  {\normalfont\normalsize\bfseries\color{vheading}}
  {\thesubsubsection}{0.6em}{}
\titlespacing*{\section}{0pt}{3.2ex plus 1ex minus .2ex}{1.6ex plus .2ex}
\titlespacing*{\subsection}{0pt}{3.6ex plus 1ex minus .2ex}{0.9ex plus .2ex}

% titlesec hook: start every \section on a fresh page (also covers starred sections).
\newcommand{\sectionbreak}{\clearpage}

% --- Headers / footers --------------------------------------------------------
% A faint hairline under the header sets a clear ceiling for the running
% content. The footer stays ruleless so it doesn't compete with the
% header rule visually.
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.3pt}
\renewcommand{\headrule}{\hbox to\headwidth{\color{vrule}\leaders\hrule height 0.3pt\hfill}}
\renewcommand{\footrulewidth}{0pt}
\fancyhead[L]{\footnotesize\sffamily\color{vmuted}\reportclient\,\textbf{·}\,\reportshortname}
\fancyhead[R]{\footnotesize\sffamily\color{vmuted}\reportversion}
\fancyfoot[L]{\footnotesize\sffamily\color{vmuted}LFG Labs formal methods \textbf{·} Verity model}
\fancyfoot[R]{\footnotesize\sffamily\color{vmuted}\thepage}

\fancypagestyle{plain}{%
  \fancyhf{}%
  \fancyfoot[L]{\footnotesize\sffamily\color{vmuted}LFG Labs formal methods \textbf{·} Verity model}%
  \fancyfoot[R]{\footnotesize\sffamily\color{vmuted}\thepage}%
  \renewcommand{\headrulewidth}{0pt}%
}

% --- Misc packages ------------------------------------------------------------
\RequirePackage{enumitem}
\setlist{itemsep=2pt, topsep=4pt, parsep=0pt}
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{array}
% Page-breakable variant of tabularx. xltabular provides a separate environment
% and restores the original tabularx, so existing single-page tables are
% unaffected; only the tall assumption/out-of-model tables opt in.
\RequirePackage{xltabular}
% Make X columns vertically centered so short single-line headers (e.g. \thead)
% align with the baseline of neighboring l/c/r columns. The default p{...}
% behavior anchors first-line top to the row top, which sinks footnotesize text.
\renewcommand\tabularxcolumn[1]{>{\arraybackslash}m{#1}}
% Roomier rows everywhere - keep tables airy and easy to scan.
\renewcommand{\arraystretch}{1.32}
% Slightly tighter rule spacing on booktabs so the extra row stretch doesn't
% leave a floating gap above \midrule.
\setlength{\aboverulesep}{0.4pt}
\setlength{\belowrulesep}{1.2pt}
\setlength{\heavyrulewidth}{0.45pt}
\setlength{\lightrulewidth}{0.30pt}
\setlength{\cmidrulewidth}{0.30pt}
% Soft separator between data rows in multi-row tables. It reads as lighter than the
% structural top/mid/bottom rules through COLOR (vrulesoft vs vrule), not width: the
% 0.5pt width is deliberately wider than \lightrulewidth so the line clears one full
% device pixel and stays visible in tall multi-line rows (a 0.3pt rule is sub-pixel at
% on-screen DPI and anti-aliases to near-nothing in a lone gap between tall cells).
\newcommand{\rowsep}{\arrayrulecolor{vrulesoft}\specialrule{0.5pt}{1.5pt}{1.5pt}\arrayrulecolor{vrule}}
\RequirePackage{graphicx}
\RequirePackage{caption}
\captionsetup{font=small, labelfont={sf,bf,color=vink}, textfont=sf}
