                  Audit.Verity.AddressTx.observeAddress inp
                      ((Audit.Verity.AddressTx.executePinnedSource inp).run (Audit.Verity.AddressTx.stateFor inp)) =
                    Audit.Verity.AddressTx.sourceAddressView inp) ∧
          (∀ (program : Contract Unit) (state rollback : ContractState) (reason : String),
              program.run state = ContractResult.revert reason rollback → rollback = state) ∧
            (∀ (state rollback : ContractState) (reason : String),
                (Audit.Verity.AddressTx.AddressTxContract.requestWithdrawal 3 7 1 true false).run state =
                    ContractResult.revert reason rollback →
                  rollback = state) ∧
              (∀ (state rollback : ContractState) (reason : String),
                  (Audit.Verity.AddressTx.AddressTxContract.claimWithdrawal 7 1 true true true false).run state =
